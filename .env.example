# === Aplicação ===
APP_NAME="Flowra Care"
ENVIRONMENT=development           # development | staging | production
DEBUG=true

# === Banco de dados (PostgreSQL) ===
# Atenção LGPD: em produção, garantir criptografia em repouso no provedor de banco
# e isolamento de schema/instância em relação à Flowra AI (CRM).
DATABASE_URL=postgresql+asyncpg://flowra:flowra@localhost:5432/flowra_care

# === Autenticação (JWT — perfil médico) ===
# Gere um segredo forte: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=troque-este-segredo-em-producao
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# === Módulo de IA (análise do texto/áudio livre) ===
# strategy: keyword (determinístico, default do MVP, roda sem chave) | llm (plugável)
FREE_TEXT_ANALYZER=keyword
# LLM_API_KEY=            # usado apenas quando FREE_TEXT_ANALYZER=llm
# LLM_MODEL=

# === CORS (painel médico / app paciente) ===
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
