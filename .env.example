# === Aplicação ===
APP_NAME="Flowra Care"
ENVIRONMENT=development           # development | staging | production
DEBUG=true

# === Banco de dados (PostgreSQL) ===
# Atenção LGPD: em produção, garantir criptografia em repouso no provedor de banco
# e isolamento de schema/instância em relação à Flowra AI (CRM).
DATABASE_URL=postgresql+asyncpg://flowra:flowra@localhost:5432/flowra_care

# === Autenticação (JWT — perfil médico) ===
# Gere um segredo forte: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=troque-este-segredo-em-producao
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30
# Base do link de redefinição (painel); se vazio, envia só o token
# PASSWORD_RESET_URL_BASE=https://app.flowraai.com.br/redefinir-senha

# Rate limiting (janela deslizante em memória) dos endpoints sensíveis
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT_ATTEMPTS=10
PASSWORD_RESET_RATE_LIMIT_ATTEMPTS=5

# === Risco por tendência e não-adesão ===
RISK_TREND_WINDOW=5          # nº de check-ins recentes considerados na tendência
INACTIVITY_ALERT_DAYS=2      # dias sem check-in que disparam alerta de não-adesão

# === Anexos (fotos/arquivos/áudio) ===
# Backend de armazenamento: local (default, disco) | (produção: object storage/S3)
STORAGE_BACKEND=local
STORAGE_DIR=./var/uploads
# UPLOAD_MAX_BYTES=10485760  # 10 MB
# UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf,audio/mpeg,audio/mp4,audio/aac,audio/ogg,audio/webm,audio/wav

# === Transcrição de áudio no check-in ===
# none (default, não transcreve) | openai (endpoint Whisper-compat)
TRANSCRIPTION_PROVIDER=none
# TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
# TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_MODEL=whisper-1

# === Módulo de IA (análise do texto/áudio livre) ===
# strategy: keyword (determinístico, default do MVP, roda sem chave) | llm
FREE_TEXT_ANALYZER=keyword
# LLM via endpoint compatível com a API OpenAI (OpenAI, Azure, Gemini-compat,
# Groq, OpenRouter, modelos locais...). O LLM é combinado de forma conservadora
# com o determinístico (mantém o maior risco); sem chave, cai no determinístico.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=20

# === CORS (painel médico / app paciente) ===
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# === Onboarding do paciente ===
# Base do link do app/PWA enviado ao contato do paciente (link = base?token=...).
# Se vazio, a mensagem inclui só o token.
# PATIENT_APP_URL_BASE=https://app.flowraai.com.br/checkin

# === Notificações ao médico (alertas) ===
# Canais ativos (CSV): log | email | webhook | whatsapp. O default 'log' roda sem config.
NOTIFICATION_CHANNELS=log
# SMTP (canal email)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=alertas@flowraai.com.br
# SMTP_USE_TLS=true
# Webhook (ponte genérica): recebe POST {target, subject, body}
# NOTIFICATION_WEBHOOK_URL=
# WhatsApp (Meta Cloud API) — destino é o telefone (Doctor.notification_phone /
# contato do paciente). Fora da janela de 24h, a Meta exige template aprovada.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANG=pt_BR
